amends "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.13.0/hk@2.13.0#/Builtins.pkl"

profiles = List("docs", "code", "security")
terminal_progress = false
display_skip_reasons = List()

local cargo_manifests = List("Cargo.toml", "**/Cargo.toml", "Cargo.lock", "rust-toolchain.toml")

steps {
  ["autocorrect"] {
    profiles = List("docs")
    glob = List("*.md")
    check = "autocorrect --config .config/autocorrectrc --lint {{files}}"
    fix = "autocorrect --config .config/autocorrectrc --fix {{files}}"
  }

  ["rumdl"] {
    profiles = List("docs")
    glob = List("*.md")
    check = "rumdl check --config .config/rumdl.toml {{files}}"
    fix = "rumdl check --config .config/rumdl.toml --fix {{files}}"
  }

  ["mmdr"] {
    profiles = List("docs", "!fmt")
    glob = List("*.md")
    check = "for f in {{files}}; do if grep -q '```mermaid' \"$f\"; then mmdr -i \"$f\" --size --fastText >/dev/null || exit 1; fi; done"
  }

  ["lychee"] {
    profiles = List("docs", "!fmt")
    glob = List("*.md")
    check = "lychee --config .config/lychee.toml --offline {{files}}"
  }

  ["typos"] = (Builtins.typos) {
    profiles = List("docs", "!fmt")
    exclude = List("CHANGELOG.md")
  }

  ["zizmor"] {
    profiles = List("security", "!fmt")
    glob = List(".github/workflows/*.yml", ".github/workflows/*.yaml")
    check = "zizmor --offline --quiet {{files}}"
  }

  ["cargo_fmt"] = (Builtins.cargo_fmt) {
    profiles = List("code")
  }

  ["ast_grep"] {
    profiles = List("code", "!fmt")
    glob = List("**/*.rs")
    check = "ast-grep scan {{files}}"
  }

  ["ast_grep_rules"] {
    profiles = List("code", "!fmt")
    glob = List("sgconfig.yml", "rules/**/*.yml")
    check = "ast-grep scan"
  }

  ["cargo_clippy"] {
    profiles = List("code", "!fmt")
    glob = cargo_manifests + List("**/*.rs", "clippy.toml")
    check = "cargo clippy -q --workspace --all-targets --locked -- -D warnings"
  }

  ["cargo_test"] {
    profiles = List("code", "!fmt")
    glob = cargo_manifests + List("**/*.rs")
    check = "cargo nextest run --workspace --locked --no-tests=pass --cargo-quiet --status-level=fail --final-status-level=fail --show-progress=none"
  }

  ["mise_lock"] {
    profiles = List("code")
    glob = List("mise.toml")
    fix = "mise lock"
    stage = List("mise.lock")
  }
}

hooks {
  ["commit-msg"] {
    steps {
      ["conventional_commit"] = Builtins.check_conventional_commit
    }
  }

  ["pre-push"] {
    steps {
      ["cargo_deny"] {
        glob = cargo_manifests + List("deny.toml")
        check = "cargo deny --locked -L error check --hide-inclusion-graph"
      }
    }
  }
}
